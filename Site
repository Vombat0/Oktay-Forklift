    <!-- =====================================================================
         JAVASCRIPT: TEMA KONTROLÜ, SERVİS KONFİGÜRATÖRÜ, FİLTRELER & BAKIM CETVELİ
    ====================================================================== -->
    <script>
        /* -------------------------------------------------------------------
           3. HERO HIZLI ARIZA & SERVİS TALEP KONFİGÜRATÖRÜ (NETLIFY + WHATSAPP)
        -------------------------------------------------------------------- */
        let selectedMachineType = 'Dizel Forklift';
        const machineBtns = document.querySelectorAll('.machine-type-btn');
        const dispatchMachineInput = document.getElementById('dispatch-machine-input');

        machineBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                selectedMachineType = btn.getAttribute('data-machine');
                if (dispatchMachineInput) {
                    dispatchMachineInput.value = selectedMachineType;
                }
                machineBtns.forEach(b => {
                    b.className = 'machine-type-btn px-3 py-2.5 rounded-lg border text-xs font-semibold text-left transition-all border-slate-200 dark:border-oktay-darkBorder bg-slate-50 dark:bg-oktay-darkSurface text-slate-700 dark:text-slate-200 hover:border-oktay-navy';
                    if (b.getAttribute('data-machine') === 'Akülü / Manuel Transpalet') {
                        b.classList.add('col-span-2', 'sm:col-span-2');
                    }
                });
                btn.className = 'machine-type-btn active-selection px-3 py-2.5 rounded-lg border text-xs font-bold text-left transition-all border-oktay-navy bg-oktay-navy text-white dark:border-sky-400 dark:bg-sky-500 dark:text-slate-950';
                if (selectedMachineType === 'Akülü / Manuel Transpalet') {
                    btn.classList.add('col-span-2', 'sm:col-span-2');
                }
            });
        });

        // Netlify Forms AJAX Gönderim Yardımcı Fonksiyonu
        async function submitToNetlifyForms(formElement) {
            try {
                const formData = new FormData(formElement);
                const encodedBody = new URLSearchParams(formData).toString();
                await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: encodedBody
                });
            } catch (err) {
                // Lokal önizleme ortamında hata fırlatmadan devam eder, Netlify'da tam çalışır
                console.info('Lokal önizleme: Netlify Forms kaydı canlı ortamda aktif olur.');
            }
        }

        const quickDispatchForm = document.getElementById('quick-dispatch-form');
        const dispatchResultBox = document.getElementById('dispatch-result-box');
        const dispatchRefCode = document.getElementById('dispatch-ref-code');
        const dispatchRefInput = document.getElementById('dispatch-ref-input');
        const dispatchSummaryText = document.getElementById('dispatch-summary-text');
        const dispatchWhatsappLink = document.getElementById('dispatch-whatsapp-link');
        const dispatchMailtoLink = document.getElementById('dispatch-mailto-link');

        quickDispatchForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const category = document.getElementById('dispatch-category').value;
            const companyOrName = document.getElementById('dispatch-company-input').value.trim();
            const brandNote = document.getElementById('dispatch-brand-input').value.trim();
            const phone = document.getElementById('dispatch-phone-input').value.trim();
            const urgencyRadio = document.querySelector('input[name="aciliyet_durumu"]:checked');
            const urgency = urgencyRadio ? urgencyRadio.value : 'ACİL';

            const randomRef = 'OKT-' + Math.floor(1000 + Math.random() * 9000);
            if (dispatchRefInput) dispatchRefInput.value = randomRef;

            // 1. Netlify Forms'a Arka Planda Kaydet
            await submitToNetlifyForms(quickDispatchForm);

            // 2. Özet ve Doğrudan WhatsApp / E-Posta Bağlantılarını Hazırla
            const summaryString = `Kayıt: #${randomRef} | Firma/Yetkili: ${companyOrName} | Makina: ${selectedMachineType} (${brandNote}) | Hizmet: ${category} | Durum: ${urgency} | Tel: ${phone}`;

            dispatchRefCode.textContent = '#' + randomRef;
            dispatchSummaryText.textContent = summaryString;

            const waMessage = encodeURIComponent(
                `Merhaba Hüseyin Bey (Oktay Forklift Servisi),\n\nWeb sitenizden servis kaydı oluşturdum:\n• Kayıt No: #${randomRef}\n• Firma / Yetkili: ${companyOrName}\n• Makina Tipi: ${selectedMachineType}\n• Marka / Konum Notu: ${brandNote}\n• Talep / Arıza: ${category}\n• Aciliyet: ${urgency}\n• Telefon: ${phone}`
            );
            dispatchWhatsappLink.href = `https://wa.me/905339240425?text=${waMessage}`;

            const mailSubject = encodeURIComponent(`Servis Talebi #${randomRef} - ${companyOrName}`);
            dispatchMailtoLink.href = `mailto:info@oktayforkliftservisi.com?subject=${mailSubject}&body=${waMessage}`;

            dispatchResultBox.classList.remove('hidden');
        });

        /* -------------------------------------------------------------------
           4. HİZMET KATEGORİ FİLTRELEME SİSTEMİ
        -------------------------------------------------------------------- */
        const serviceTabBtns = document.querySelectorAll('.service-tab-btn');
        const serviceCards = document.querySelectorAll('.service-card');

        serviceTabBtns.forEach(tab => {
            tab.addEventListener('click', () => {
                const filterVal = tab.getAttribute('data-filter');

                serviceTabBtns.forEach(t => {
                    t.className = 'service-tab-btn px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-white dark:bg-oktay-darkCard text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-oktay-darkBorder hover:border-oktay-navy transition-all cursor-pointer';
                });
                tab.className = 'service-tab-btn px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-oktay-navy text-white dark:bg-sky-500 dark:text-slate-950 transition-all cursor-pointer';

                serviceCards.forEach(card => {
                    const categories = card.getAttribute('data-category');
                    if (filterVal === 'all' || categories.includes(filterVal)) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                });
            });
        });

        function selectServiceForQuote(serviceTitle) {
            const selectEl = document.getElementById('contact-service-select');
            if (selectEl) {
                selectEl.value = serviceTitle;
            }
            document.getElementById('iletisim').scrollIntoView({ behavior: 'smooth' });
            setTimeout(() => {
                document.getElementById('contact-name').focus();
            }, 600);
        }

        /* -------------------------------------------------------------------
