                        '1000 saat bakımındaki tüm redüktör ve filtre işlemlerinin uygulanması',
                        'Hidrolik sistem yağının komple yenilenmesi ve valf basınç ayarı',
                        'Yürüyüş ve pompa motoru rulmanlarının değişimi ve rotor bakımı',
                        'Sürücü kartı (IGBT) altında yer alan termal macunların yenilenmesi',
                        'Tekerlek porya rulmanlarının sökülerek temizlenmesi ve greslenmesi',
                        'Asansör zincirleri, hortum makaraları ve hidrolik hortumların yenilenmesi',
                        'Traksiyoner akü hücrelerinin kapasite raporu ve sülfat giderme işlemi',
                        'Tam yük altında elektronik akım çekiş ve kaldırma hızı testi'
                    ]
                }
            }
        };

        let activePowertrain = 'ic';
        let activeHour = '250';

        function renderMaintenanceModule() {
            const data = maintenanceDatabase[activePowertrain][activeHour];
            const powertrainLabel = maintenanceDatabase[activePowertrain].label;

            document.getElementById('maint-badge-title').textContent = `${powertrainLabel} — ${activeHour} SAAT PERİYODİK BAKIM PROTOKOLÜ`;
            document.getElementById('maint-main-heading').textContent = data.heading;
            document.getElementById('maint-duration-spec').textContent = data.duration;

            const container = document.getElementById('maint-checklist-container');
            container.innerHTML = data.items.map((item, idx) => `
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white dark:bg-oktay-darkCard border border-slate-200/80 dark:border-oktay-darkBorder">
                    <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-oktay-navy/10 dark:bg-sky-400/15 text-oktay-navy dark:text-sky-300 shrink-0 mt-0.5">
                        0${idx + 1}
                    </span>
                    <span class="text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200 leading-snug">
                        ${item}
                    </span>
                </div>
            `).join('');
        }

        function switchPowertrain(type) {
            activePowertrain = type;
            const icBtn = document.getElementById('powertrain-ic-btn');
            const evBtn = document.getElementById('powertrain-ev-btn');

            if (type === 'ic') {
                icBtn.className = 'px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-oktay-navy text-white dark:bg-sky-500 dark:text-slate-950 shadow-sm transition-all cursor-pointer';
                evBtn.className = 'px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer';
            } else {
                evBtn.className = 'px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-oktay-navy text-white dark:bg-sky-500 dark:text-slate-950 shadow-sm transition-all cursor-pointer';
                icBtn.className = 'px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer';
            }
            renderMaintenanceModule();
        }

        function selectMaintenanceHour(hour) {
            activeHour = hour;
            document.querySelectorAll('.maint-hour-btn').forEach(btn => {
                const btnHour = btn.getAttribute('data-hour');
                const titleSpan = btn.querySelector('span:first-child');
                if (btnHour === hour) {
                    btn.className = 'maint-hour-btn p-4 rounded-xl border-2 border-oktay-navy dark:border-sky-400 bg-oktay-navy/5 dark:bg-sky-400/10 text-left transition-all cursor-pointer';
                    titleSpan.className = 'font-mono font-extrabold text-xl sm:text-2xl text-oktay-navy dark:text-sky-400';
                } else {
                    btn.className = 'maint-hour-btn p-4 rounded-xl border border-slate-200 dark:border-oktay-darkBorder bg-slate-50 dark:bg-oktay-darkSurface text-left hover:border-oktay-navy transition-all cursor-pointer';
                    titleSpan.className = 'font-mono font-extrabold text-xl sm:text-2xl text-slate-800 dark:text-white';
                }
            });
            renderMaintenanceModule();
        }

        function scheduleSelectedMaintenance() {
            const powertrainLabel = maintenanceDatabase[activePowertrain].label;
            const selectEl = document.getElementById('contact-service-select');
            const detailsEl = document.getElementById('contact-details');
            if (selectEl) {
                selectEl.value = 'Kurumsal Periyodik Bakım ve Filo Yönetimi';
            }
            if (detailsEl) {
                detailsEl.value = `${powertrainLabel} için ${activeHour} Saat Periyodik Bakım Paketi randevusu ve fiyat teklifi talep ediyorum.`;
            }
            document.getElementById('iletisim').scrollIntoView({ behavior: 'smooth' });
            setTimeout(() => {
                document.getElementById('contact-name').focus();
            }, 600);
        }

        // İlk yüklemede bakım cetvelini oluştur
        renderMaintenanceModule();

        /* -------------------------------------------------------------------
           6. S.S.S. AKORDEON ETKİLEŞİMİ
        -------------------------------------------------------------------- */
        document.querySelectorAll('.faq-trigger').forEach(trigger => {
            trigger.addEventListener('click', () => {
                const content = trigger.nextElementSibling;
                const icon = trigger.querySelector('.faq-icon');
                const isOpen = !content.classList.contains('hidden');

                document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
                document.querySelectorAll('.faq-icon').forEach(i => i.textContent = '+');

                if (!isOpen) {
                    content.classList.remove('hidden');
                    icon.textContent = '−';
                }
            });
        });

        /* -------------------------------------------------------------------
           7. KURUMSAL İLETİŞİM FORMU (NETLIFY FORMS + WHATSAPP KÖPRÜSÜ)
        -------------------------------------------------------------------- */
        const corporateContactForm = document.getElementById('corporate-contact-form');
        const contactFormFeedback = document.getElementById('contact-form-feedback');
        const contactRefBadge = document.getElementById('contact-ref-badge');
        const contactWaBridge = document.getElementById('contact-wa-bridge');
        const contactMailBridge = document.getElementById('contact-mail-bridge');

        corporateContactForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const name = document.getElementById('contact-name').value.trim();
            const company = document.getElementById('contact-company').value.trim();
            const phone = document.getElementById('contact-phone').value.trim();
            const email = document.getElementById('contact-email').value.trim() || 'Belirtilmedi';
            const service = document.getElementById('contact-service-select').value;
            const fleetCount = document.getElementById('contact-fleet-count').value;
            const details = document.getElementById('contact-details').value.trim();
            const refId = 'OKT-' + Math.floor(1000 + Math.random() * 9000);

            // 1. Netlify Forms'a otomatik kaydet
            await submitToNetlifyForms(corporateContactForm);

            // 2. WhatsApp & E-Posta köprülerini hazırla
            contactRefBadge.textContent = '#' + refId;
            const messageBody = encodeURIComponent(
                `Merhaba Hüseyin Bey (Oktay Forklift Servisi),\n\nKurumsal Servis & Teklif Formu üzerinden talebimiz:\n• Referans No: #${refId}\n• Firma: ${company}\n• Yetkili: ${name}\n• Telefon: ${phone}\n• E-Posta: ${email}\n• Hizmet: ${service}\n• Makina Sayısı: ${fleetCount}\n• Detaylar: ${details}`
            );
            contactWaBridge.href = `https://wa.me/905339240425?text=${messageBody}`;
            contactMailBridge.href = `mailto:info@oktayforkliftservisi.com?subject=${encodeURIComponent('Kurumsal Servis Talebi #' + refId + ' - ' + company)}&body=${messageBody}`;

            contactFormFeedback.classList.remove('hidden');
            corporateContactForm.reset();
        });

        function copyTextToClipboard(text, targetElement) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            const originalText = targetElement.textContent;
            targetElement.textContent = 'Kopyalandı!';
            setTimeout(() => {
                targetElement.textContent = originalText;
            }, 2000);
        }
    </script>
